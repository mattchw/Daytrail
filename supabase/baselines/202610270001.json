            "using": "((( SELECT auth.uid() AS uid) = owner_id) AND (EXISTS ( SELECT 1\n   FROM daytrail_trips t\n  WHERE ((t.owner_id = daytrail_travel_marks.owner_id) AND (t.trip_id = daytrail_travel_marks.trip_id) AND (t.deleted_at IS NULL)))))",

            "name": "daytrail_end_state",
            "validated": true,
            "definition": "CHECK (((split_part(target_id, ':'::text, 1) <> 'end'::text) OR (state <> 'skipped'::text)))"
          },
          {
            "name": "daytrail_travel_marks_owner_id_trip_id_fkey",
            "validated": true,
            "definition": "FOREIGN KEY (owner_id, trip_id) REFERENCES daytrail_trips(owner_id, trip_id) ON DELETE CASCADE"
          },
          {
            "name": "daytrail_travel_marks_pkey",
            "validated": true,
            "definition": "PRIMARY KEY (owner_id, trip_id, target_id)"
          },
          {
            "name": "daytrail_travel_marks_place_id_check",
            "validated": true,
            "definition": "CHECK (daytrail_private.valid_id(place_id))"
          },
          {
            "name": "daytrail_travel_marks_revision_check",
            "validated": true,
            "definition": "CHECK (((revision >= 1) AND (revision <= '9007199254740991'::bigint)))"
          },
          {
            "name": "daytrail_travel_marks_state_check",
            "validated": true,
            "definition": "CHECK ((state = ANY (ARRAY['planned'::text, 'done'::text, 'skipped'::text])))"
          },
          {
            "name": "daytrail_travel_marks_target_id_check",
            "validated": true,
            "definition": "CHECK (daytrail_private.valid_travel_target(target_id))"
          }

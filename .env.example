VITE_GOOGLE_MAPS_API_KEY=your_restricted_browser_api_key
VITE_GOOGLE_MAPS_MAP_ID=your_javascript_map_id

# Optional Google sign-in through Supabase Auth. Leave both blank for guest mode.
# See docs/GOOGLE_SIGN_IN_SETUP.md. These are browser-visible values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put a Google OAuth client secret, Supabase secret key, or service_role key here.
